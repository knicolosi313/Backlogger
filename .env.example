# Meeting-to-Backlog — example environment (NO real credentials; copy to .env and fill in)
# Proposed keys; names may change as implementation starts.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
# Creativity default: conservative | balanced | creative | exploratory
DEFAULT_CREATIVITY=balanced

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Object / media storage ---
MEDIA_STORAGE=local   # local | s3
MEDIA_LOCAL_PATH=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Trello ---
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_OAUTH_CALLBACK_URL=

# --- GitHub (stretch) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- App security ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ALLOWED_ORIGINS=

# --- Limits & retention ---
MAX_UPLOAD_MB=
DEFAULT_RETENTION_DAYS=
