# Meeting-to-Backlog — example environment (NO real credentials; copy to .env and fill in)
# Proposed keys; names may change as implementation starts.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
# Creativity default: conservative | balanced | creative | exploratory
DEFAULT_CREATIVITY=balanced
# Cache per-story semantic vectors; false uses keyword-based board context.
STORY_EMBEDDINGS_ENABLED=true

# --- Database (PostgreSQL + TimescaleDB) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Object / media storage ---
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./media
# Set MEDIA_STORAGE=supabase to store new uploads in a private bucket.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_BUCKET=your-bucket-name
# Backend-only key (sb_secret_...); never expose it in the extension.
SUPABASE_SECRET_KEY=your-secret-key
# Legacy service_role JWT can be used instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Trello ---
TRELLO_API_KEY=
# One application key; each browser connects its own Trello account.
# Tokens are encrypted in the database, not read from a shared TRELLO_TOKEN.
TRELLO_API_SECRET=
# Add this origin to the Trello app key's allowed origins.
TRELLO_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/integrations/trello/callback

# --- Jira Cloud (Atlassian OAuth 2.0 app) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/integrations/jira/callback

# --- GitHub (stretch) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- App security ---
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Comma-separated frontend origins; use explicit origins, not '*', with cookies.
ALLOWED_ORIGINS=

# --- Limits & retention ---
MAX_UPLOAD_MB=100
DEFAULT_RETENTION_DAYS=
